@base = http://localhost:5088
@categoryId = 00000000-0000-0000-0000-000000000000
@productId = 00000000-0000-0000-0000-000000000000

### Health
GET {{base}}/health

### OpenAPI
GET {{base}}/openapi/v1.json

### List categories
GET {{base}}/api/v1/categories

### List categories including inactive
GET {{base}}/api/v1/categories?includeInactive=true

### Create category
POST {{base}}/api/v1/categories
Content-Type: application/json

{
  "name": "Accessories",
  "description": "Cables, cases, and mounts"
}

### Get category
GET {{base}}/api/v1/categories/{{categoryId}}

### Update category
PUT {{base}}/api/v1/categories/{{categoryId}}
Content-Type: application/json

{
  "name": "Accessories",
  "description": "Updated description",
  "isActive": true
}

### Delete category
DELETE {{base}}/api/v1/categories/{{categoryId}}

### Query products
GET {{base}}/api/v1/products?page=1&pageSize=25

### Search products
GET {{base}}/api/v1/products?search=KB&page=1&pageSize=10

### Products in a category
GET {{base}}/api/v1/products?categoryId={{categoryId}}

### Create product
POST {{base}}/api/v1/products
Content-Type: application/json

{
  "sku": "cam-9",
  "name": "USB Camera",
  "description": "1080p",
  "price": 79.00,
  "stock": 4,
  "categoryId": "{{categoryId}}"
}

### Get product
GET {{base}}/api/v1/products/{{productId}}

### Update product
PUT {{base}}/api/v1/products/{{productId}}
Content-Type: application/json

{
  "name": "USB Camera",
  "description": "1080p with mic",
  "price": 69.00,
  "isActive": true,
  "categoryId": "{{categoryId}}"
}

### Increase stock
POST {{base}}/api/v1/products/{{productId}}/stock
Content-Type: application/json

{
  "delta": 5
}

### Decrease stock
POST {{base}}/api/v1/products/{{productId}}/stock
Content-Type: application/json

{
  "delta": -1
}

### Delete product
DELETE {{base}}/api/v1/products/{{productId}}

### Validation error example
POST {{base}}/api/v1/products
Content-Type: application/json

{
  "sku": "",
  "name": "",
  "description": null,
  "price": -1,
  "stock": -4,
  "categoryId": "00000000-0000-0000-0000-000000000000"
}
